from __future__ import annotations

import json
from pathlib import Path

from PIL import Image, ImageDraw, ImageFilter, ImageFont, ImageOps


ROOT = Path(__file__).resolve().parent
SOURCE_SCREEN = ROOT / "source" / "home-actions-simplified.png"
GENERATED_BACKGROUND = ROOT / "generated" / "poster-background.png"
DETERMINISTIC_BASE = ROOT / "source" / "deterministic-layout.png"
FINAL_POSTER = ROOT / "final" / "quitcount-poster-1080x1440.png"
MANIFEST = ROOT / "data" / "manifest.json"
APP_ICON = ROOT.parents[2] / "logos" / "quitcount-app-icon-20260714" / "final" / "app-icon-1024.png"

WIDTH = 1080
HEIGHT = 1440

INK = "#103F35"
INK_DARK = "#0A2D27"
MUTED = "#52645F"
MINT = "#DCEFE6"
MINT_LIGHT = "#EEF7F2"
CORAL = "#C9484F"
PAPER = "#F8F7F2"
WHITE = "#FFFFFF"


def font_path(bold: bool = False) -> str:
    candidates = [
        Path(r"C:\Windows\Fonts\msyhbd.ttc" if bold else r"C:\Windows\Fonts\msyh.ttc"),
        Path(r"C:\Windows\Fonts\simhei.ttf"),
    ]
    for candidate in candidates:
        if candidate.exists():
            return str(candidate)
    raise FileNotFoundError("No supported Chinese font found")


def font(size: int, bold: bool = False) -> ImageFont.FreeTypeFont:
    return ImageFont.truetype(font_path(bold), size=size)


def rounded_mask(size: tuple[int, int], radius: int) -> Image.Image:
    mask = Image.new("L", size, 0)
    ImageDraw.Draw(mask).rounded_rectangle((0, 0, size[0], size[1]), radius=radius, fill=255)
    return mask


def draw_text(draw: ImageDraw.ImageDraw, xy: tuple[int, int], text: str, size: int,
              color: str, bold: bool = False, spacing: int = 8) -> None:
    draw.multiline_text(xy, text, fill=color, font=font(size, bold), spacing=spacing)


def draw_pill(draw: ImageDraw.ImageDraw, xy: tuple[int, int], text: str) -> None:
    pill_font = font(24, True)
    bbox = draw.textbbox((0, 0), text, font=pill_font)
    width = bbox[2] - bbox[0] + 44
    height = 54
    x, y = xy
    draw.rounded_rectangle((x, y, x + width, y + height), radius=27, fill=MINT)
    draw.text((x + 22, y + 10), text, fill=INK, font=pill_font)


def draw_feature(draw: ImageDraw.ImageDraw, y: int, number: str, title: str, detail: str) -> None:
    draw.ellipse((62, y, 108, y + 46), fill=INK)
    number_font = font(20, True)
    box = draw.textbbox((0, 0), number, font=number_font)
    tx = 85 - (box[2] - box[0]) // 2
    draw.text((tx, y + 8), number, fill=WHITE, font=number_font)
    draw.text((128, y - 2), title, fill=INK_DARK, font=font(29, True))
    draw.text((128, y + 37), detail, fill=MUTED, font=font(22))


def build_background(use_generated: bool) -> Image.Image:
    if use_generated and GENERATED_BACKGROUND.exists():
        background = Image.open(GENERATED_BACKGROUND).convert("RGB")
        background = ImageOps.fit(background, (WIDTH, HEIGHT), method=Image.Resampling.LANCZOS)
        wash = Image.new("RGBA", (WIDTH, HEIGHT), (248, 247, 242, 120))
        background = Image.alpha_composite(background.convert("RGBA"), wash)
    else:
        background = Image.new("RGBA", (WIDTH, HEIGHT), PAPER)

    structure = Image.new("RGBA", (WIDTH, HEIGHT), (0, 0, 0, 0))
    sdraw = ImageDraw.Draw(structure)
    if not use_generated or not GENERATED_BACKGROUND.exists():
        for y in range(0, HEIGHT, 48):
            sdraw.line((0, y, WIDTH, y), fill=(16, 63, 53, 12), width=1)
        sdraw.rounded_rectangle((535, 158, 1060, 1290), radius=54, fill=(220, 239, 230, 185))
        for inset in (0, 42, 84, 126):
            sdraw.ellipse((430 + inset, 68 + inset, 1180 - inset, 818 - inset),
                          outline=(201, 72, 79, 34 + inset // 4), width=3)
        sdraw.polygon(((0, 1220), (420, 1060), (620, 1440), (0, 1440)), fill=(201, 72, 79, 16))
    sdraw.rectangle((0, 0, 24, HEIGHT), fill=INK)
    sdraw.rounded_rectangle((44, 52, 536, 122), radius=35, fill=(255, 255, 255, 176))
    sdraw.line((60, 1110, 500, 1110), fill=(16, 63, 53, 70), width=2)
    sdraw.rectangle((0, 1350, WIDTH, HEIGHT), fill=(16, 63, 53, 242))
    return Image.alpha_composite(background, structure)


def add_phone(canvas: Image.Image) -> None:
    screenshot = Image.open(SOURCE_SCREEN).convert("RGB")
    target_width = 426
    target_height = round(target_width * screenshot.height / screenshot.width)
    screenshot = screenshot.resize((target_width, target_height), Image.Resampling.LANCZOS)

    frame_pad = 15
    frame_size = (target_width + frame_pad * 2, target_height + frame_pad * 2)
    phone = Image.new("RGBA", frame_size, (0, 0, 0, 0))
    phone_draw = ImageDraw.Draw(phone)
    phone_draw.rounded_rectangle((0, 0, frame_size[0] - 1, frame_size[1] - 1), radius=44,
                                 fill=INK_DARK, outline=(255, 255, 255, 220), width=3)
    screen_mask = rounded_mask((target_width, target_height), 31)
    phone.paste(screenshot, (frame_pad, frame_pad), screen_mask)

    x, y = 574, 218
    shadow = Image.new("RGBA", (WIDTH, HEIGHT), (0, 0, 0, 0))
    shadow_draw = ImageDraw.Draw(shadow)
    shadow_draw.rounded_rectangle((x + 12, y + 18, x + frame_size[0] + 12, y + frame_size[1] + 18),
                                  radius=48, fill=(6, 36, 31, 90))
    shadow = shadow.filter(ImageFilter.GaussianBlur(28))
    canvas.alpha_composite(shadow)
    canvas.alpha_composite(phone, (x, y))


def compose(use_generated: bool, output: Path) -> None:
    canvas = build_background(use_generated)
    draw = ImageDraw.Draw(canvas)

    if APP_ICON.exists():
        icon = Image.open(APP_ICON).convert("RGBA").resize((58, 58), Image.Resampling.LANCZOS)
        canvas.alpha_composite(icon, (58, 58))
    else:
        draw.ellipse((62, 65, 108, 111), fill=CORAL)
        draw.arc((74, 75, 96, 99), start=205, end=520, fill=WHITE, width=4)
    draw.text((132, 57), "戒烟有数", fill=INK, font=font(42, True))
    draw.text((134, 103), "QUIT COUNT", fill=MUTED, font=font(17, True))
    draw_pill(draw, (790, 61), "HarmonyOS 原生版")

    draw_text(draw, (58, 188), "先看见，\n再改变。", 94, INK_DARK, True, 4)
    draw_text(draw, (62, 414), "把库存、当日危害与健康负债，\n变成每天都能读懂的戒烟账本。", 31, MUTED, False, 15)

    draw.rounded_rectangle((58, 544, 520, 620), radius=18, fill=(255, 255, 255, 205))
    draw.rectangle((58, 544, 70, 620), fill=CORAL)
    draw.text((91, 559), "每一次选择，都是更好的自己。", fill=INK, font=font(26, True))

    draw_feature(draw, 696, "1", "库存一眼看清", "知道手里还有多少潜在负担")
    draw_feature(draw, 800, "2", "取烟自动入账", "记录场景、成本与健康折算")
    draw_feature(draw, 904, "3", "提醒，但不阻塞", "中断惯性，不羞辱每次选择")

    draw.rounded_rectangle((58, 1050, 518, 1140), radius=20, fill=INK)
    draw.text((87, 1070), "本地优先 · 行为记录 · 风险提醒", fill=WHITE, font=font(25, True))

    add_phone(canvas)

    draw.text((58, 1373), "戒烟有数  |  非医学诊断，仅用于行为反馈与自我管理", fill=WHITE, font=font(21))
    draw.text((926, 1373), "2026", fill=(220, 239, 230), font=font(19, True))

    output.parent.mkdir(parents=True, exist_ok=True)
    canvas.convert("RGB").save(output, quality=96, optimize=True)


def main() -> None:
    if not SOURCE_SCREEN.exists():
        raise FileNotFoundError(f"Missing source screenshot: {SOURCE_SCREEN}")

    compose(False, DETERMINISTIC_BASE)
    compose(True, FINAL_POSTER)

    sources = [
        {"type": "product-screenshot", "path": str(SOURCE_SCREEN), "provenance": "latest Web prototype screenshot"},
        {"type": "brand-mark", "path": str(APP_ICON), "provenance": "QuitCount app icon proposal, deterministic raster master"}
    ]
    if GENERATED_BACKGROUND.exists():
        sources.append({
            "type": "generated-polish",
            "path": str(GENERATED_BACKGROUND),
            "provenance": "Codex ImageGen, no text/UI/logos"
        })

    manifest = {
        "title": "戒烟有数 HarmonyOS 宣传海报",
        "status": "review",
        "format": {"width": WIDTH, "height": HEIGHT, "unit": "px", "aspectRatio": "3:4"},
        "copy": {
            "brand": "戒烟有数",
            "headline": "先看见，再改变。",
            "subheadline": "把库存、当日危害与健康负债，变成每天都能读懂的戒烟账本。",
            "compliance": "非医学诊断，仅用于行为反馈与自我管理"
        },
        "sources": sources,
        "exports": [{"path": str(FINAL_POSTER), "channel": "generic-digital-poster"}],
        "reviewRisks": [
            "Confirm final distribution channel before platform-specific resizing",
            "No download QR or store availability claim is shown",
            "ImageGen background was not used because the worker returned no PNG after network retries"
        ]
    }
    MANIFEST.write_text(json.dumps(manifest, ensure_ascii=False, indent=2), encoding="utf-8")


if __name__ == "__main__":
    main()
