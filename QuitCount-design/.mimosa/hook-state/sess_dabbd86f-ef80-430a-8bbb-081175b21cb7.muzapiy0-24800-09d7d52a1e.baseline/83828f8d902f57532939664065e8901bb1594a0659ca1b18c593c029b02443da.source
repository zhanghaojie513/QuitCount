import React from "react";
import { createRoot } from "react-dom/client";
import { App } from "./App.jsx";
import "./styles.css";
import "./refined.css";

document.body.classList.add("refined-body");
const rootElement = document.getElementById("root");

if (rootElement) {
  rootElement.classList.add("refined-root");
  createRoot(rootElement).render(
    <React.StrictMode>
      <App />
    </React.StrictMode>,
  );
}
